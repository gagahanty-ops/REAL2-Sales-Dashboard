 import { z } from "zod";
 
 const booleanFlag = z
   .enum(["true", "false"])
   .default("false")
   .transform((value) => value === "true");
 
+const tokenEncryptionKey = z.string().refine((value) => {
+  const decoded = Buffer.from(value, "base64");
