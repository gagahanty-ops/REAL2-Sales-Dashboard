+    let entered!: () => void;
+    const acquired = new Promise<void>((resolve) => {
+      entered = resolve;
+    });
+    const first = withSyncAdvisoryLock(workerOne, fixture.connectionId, async () => {
+      entered();
+      await held;
+      return "first";
+    });
+    await acquired;
+
+    await expect(
+      withSyncAdvisoryLock(workerTwo, fixture.connectionId, async () => "second"),
