+
+  it("watchdog seals stale runs and the journal rejects later appends", async () => {
+    const fixture = await seedFixture();
+    const run = await startSyncRun(workerOne, {
+      traceId: "stale-run",
+      connectionId: fixture.connectionId,
+      configId: fixture.configId,
