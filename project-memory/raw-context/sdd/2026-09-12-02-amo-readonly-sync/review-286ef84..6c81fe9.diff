+  phone_uis: "Телефон / UIS",
+  whatsapp: "WhatsApp",
+  avito: "Avito",
+  instagram: "Instagram",
+  site: "Сайт",
+  telegram: "Telegram",
+  max: "MAX",
+  unknown: "Неизвестно",
+};
+
+export default async function ChannelSettingsPage() {
+  let user;
